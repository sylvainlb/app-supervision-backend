# ============================================================================
# app-supervision-backend — environment variables (copy to .env, edit)
# DO NOT COMMIT the .env (secrets). *_PASSWORD=CHANGE_ME are auto-generated
# at the first deploy by fap-ldp/compose/deploy.sh.
# ============================================================================

# --- Domain of the BACK (resolution: localhost → 127.0.0.1 locally) ---
# The back serves: root LDP (JSON-LD), /auth (Keycloak), /dsp, /editor (Node-RED), /app/query.
# This is the resources' BASE_IRI (the @id are in $SCHEME://$API_DOMAIN/...).
# Dev (default): API_DOMAIN=localhost → pure HTTP :80, no certificate, no browser error
#   (OIDC login over HTTP is only accepted by the client on localhost).
# Staging: non-public domain → internal self-signed HTTPS (tls internal) — import ONCE
#   .build/caddy-root.crt into the browser (Firefox → Settings → Certificates → Import).
# Prod: real domain (A record → IP), e.g. API_DOMAIN=fap.example.com → automatic Let's Encrypt HTTPS.
API_DOMAIN=localhost
# DOMAIN = alias of API_DOMAIN (emails, KC_HOSTNAME) — derived automatically, do not edit
DOMAIN=localhost

# --- Front client origins (CORS + Keycloak webOrigins/redirectUris) ---
# The front (../app-supervision) is AUTONOMOUS: it runs from its own directory
# (npm run dev → http://localhost:5173) and calls this back in absolute, cross-origin.
# Dev: origins of the autonomous client. The front is served on http://app.localhost/ (port 80:
# caddy proxies app.localhost → the client's vite server on the host, port FRONT_DEV_PORT).
# Prod: e.g. FRONT_ORIGINS="https://app.fap.example.com"
FRONT_ORIGINS="http://app.localhost http://app.localhost:5173 http://localhost:5173 http://localhost:5174 http://localhost:3000"
# Front domain (dev): caddy renders a http://app.localhost/ site → proxy to vite (host)
FRONT_DOMAIN=app.localhost
FRONT_DEV_PORT=5173

# --- Environment: dev = pure HTTP :80 (API_DOMAIN=localhost) ;
#     staging = internal self-signed HTTPS ; prod = automatic Let's Encrypt HTTPS.
# (If API_DOMAIN != localhost in dev, SCHEME switches to self-signed https: the OIDC login
#  requires a secure context outside localhost.)
# SCHEME / BASE_IRI are derived from ENV + API_DOMAIN by scripts/deploy-local.sh:
ENV=dev
SCHEME=http
BASE_IRI=http://localhost/

# --- Internal org: org claim of members (DSP framework contract, fap-ldp spec §7.1) ---
FAP_ORG=fap-pod

# --- PostgreSQL — secrets (auto-generated at the first deploy if CHANGE_ME) ---
PG_ADMIN_PASSWORD=CHANGE_ME
PG_GATE_PASSWORD=CHANGE_ME
PG_APP_PASSWORD=CHANGE_ME
PG_READER_PASSWORD=CHANGE_ME
PG_MATERIALIZER_PASSWORD=CHANGE_ME
PG_PORT=5432

# --- SFTP (external source, atmoz/sftp container) ---
SFTP_USER=fap
SFTP_PASSWORD=CHANGE_ME
SFTP_PUBLISHED_PORT=2222

# --- Keycloak demo users (realm.json, temporary passwords) ---
ALICE_PASSWORD=CHANGE_ME   # manager
BOB_PASSWORD=CHANGE_ME     # technician
ADMIN_PASSWORD=CHANGE_ME   # admin

# --- Divers ---
ORCE_PORT=1880
KEYCLOAK_PORT=8080
MQTT_PORT=1883
SIM_SITE_ID=site-berlin-001
SIM_SEED=fap-light

# --- Embedded Keycloak (realm rendered from keycloak/realm.json via ${DOMAIN}/${FAP_ORG}) ---
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# KEYCLOAK_REALM_FILE=$PWD/keycloak/realm.json   # default: $DEPLOY_DIR/keycloak/realm.json (rendered)

# --- DSP data plane (FAP-light core) ---
# Shared HMAC secret, canonical form D-3 — NEVER client-side (front spec §13.1).
# Used server-side by the POST /app/query proxy (C1.9/D-8) to sign.
DSP_HMAC_SECRET=CHANGE_ME
# Internal framework contract (members org=<pod>) for the PDP check of the /app/query proxy
DSP_AGREEMENT_ID=agreement:internal:framework-contract

# --- Front app-supervision (AUTONOMOUS: ../app-supervision, NO reference here) ---
# The client configures and launches from its own directory:
#   cd ../app-supervision && ./scripts/configure.sh http://localhost && npm run dev
#   → http://localhost:5173, POD_URL=http://localhost (cross-origin calls, CORS above)

# --- External IdP (step 1) instead of the embedded Keycloak ---
# IDP_EXTERNAL=true
# IDP_ISSUER_URL=https://idp.example/realms/fap
# IDP_CLIENT_ID=fap-ldp
