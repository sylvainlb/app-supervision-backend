# ============================================================================
# app-supervision-backend — variables d'environnement (copier en .env, éditer)
# NE PAS COMMITTER le .env (secrets). Les *_PASSWORD=CHANGE_ME sont auto-générés
# au premier deploy par fap-ldp/compose/deploy.sh.
# ============================================================================

# --- Domaine du BACK (résolution : localhost → 127.0.0.1 en local) ---
# Le back sert : LDP racine (JSON-LD), /auth (Keycloak), /dsp, /editor (Node-RED), /app/query.
# C'est la BASE_IRI des ressources (les @id sont en $SCHEME://$API_DOMAIN/...).
# Dev (défaut) : API_DOMAIN=localhost → HTTP pur :80, aucun certificat, aucune erreur navigateur
#   (le login OIDC en HTTP n'est accepté par le client que sur localhost).
# Staging : domaine non public → HTTPS auto-signé interne (tls internal) — importer UNE FOIS
#   .build/caddy-root.crt dans le navigateur (Firefox → Paramètres → Certificats → Importer).
# Prod : vrai domaine (A record → IP), ex. API_DOMAIN=fap.example.com → HTTPS Let's Encrypt auto.
API_DOMAIN=localhost
# DOMAIN = alias de API_DOMAIN (emails, KC_HOSTNAME) — dérivé automatiquement, ne pas éditer
DOMAIN=localhost

# --- Origines du client front (CORS + webOrigins/redirectUris Keycloak) ---
# Le front (../app-supervision) est AUTONOME : il tourne depuis son propre répertoire
# (npm run dev → http://localhost:5173) et appelle ce back en absolu, cross-origin.
# Dev : origines du client autonome. Le front est servi sur http://app.localhost/ (port 80 :
# caddy proxifie app.localhost → le serveur vite du client sur l'hôte, port FRONT_DEV_PORT).
# Prod : ex. FRONT_ORIGINS="https://app.fap.example.com"
FRONT_ORIGINS="http://app.localhost http://app.localhost:5173 http://localhost:5173 http://localhost:5174 http://localhost:3000"
# Domaine du front (dev) : caddy rend un site http://app.localhost/ → proxy vers vite (hôte)
FRONT_DOMAIN=app.localhost
FRONT_DEV_PORT=5173

# --- Environnement : dev = HTTP pur :80 (API_DOMAIN=localhost) ;
#     staging = HTTPS auto-signé interne ; prod = HTTPS Let's Encrypt automatique.
# (Si API_DOMAIN != localhost en dev, SCHEME passe en https auto-signé : le login OIDC
#  exige un contexte sécurisé hors localhost.)
# SCHEME / BASE_IRI sont dérivés de ENV + API_DOMAIN par scripts/deploy-local.sh :
ENV=dev
SCHEME=http
BASE_IRI=http://localhost/

# --- Org interne : claim org des membres (contrat-cadre DSP, spec fap-ldp §7.1) ---
FAP_ORG=fap-pod

# --- PostgreSQL — secrets (auto-générés au premier deploy si CHANGE_ME) ---
PG_ADMIN_PASSWORD=CHANGE_ME
PG_GATE_PASSWORD=CHANGE_ME
PG_APP_PASSWORD=CHANGE_ME
PG_READER_PASSWORD=CHANGE_ME
PG_MATERIALIZER_PASSWORD=CHANGE_ME
PG_PORT=5432

# --- SFTP (source externe, conteneur atmoz/sftp) ---
SFTP_USER=fap
SFTP_PASSWORD=CHANGE_ME
SFTP_PUBLISHED_PORT=2222

# --- Utilisateurs de démo Keycloak (realm.json, mots de passe temporaires) ---
ALICE_PASSWORD=CHANGE_ME   # gestionnaire
BOB_PASSWORD=CHANGE_ME     # technicien
ADMIN_PASSWORD=CHANGE_ME   # admin

# --- Divers ---
ORCE_PORT=1880
KEYCLOAK_PORT=8080
MQTT_PORT=1883
SIM_SITE_ID=site-berlin-001
SIM_SEED=fap-light

# --- Keycloak embarqué (realm rendu depuis keycloak/realm.json via ${DOMAIN}/${FAP_ORG}) ---
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# KEYCLOAK_REALM_FILE=$PWD/keycloak/realm.json   # défaut: $DEPLOY_DIR/keycloak/realm.json (rendu)

# --- Data plane DSP (cœur FAP-light) ---
# Secret HMAC partagé, forme canonique D-3 — JAMAIS côté navigateur (spec front §13.1).
# Utilisé côté serveur par le proxy POST /app/query (C1.9/D-8) pour signer.
DSP_HMAC_SECRET=CHANGE_ME
# Contrat-cadre interne (membres org=<pod>) pour le check PDP du proxy /app/query
DSP_AGREEMENT_ID=agreement:interne:contrat-cadre

# --- Front app-supervision (AUTONOME : ../app-supervision, AUCUNE référence ici) ---
# Le client se configure et se lance depuis son propre répertoire :
#   cd ../app-supervision && ./scripts/configure.sh http://localhost && npm run dev
#   → http://localhost:5173, POD_URL=http://localhost (appels cross-origin, CORS ci-dessus)

# --- IdP externe (étape 1) au lieu du Keycloak embarqué ---
# IDP_EXTERNAL=true
# IDP_ISSUER_URL=https://idp.example/realms/fap
# IDP_CLIENT_ID=fap-ldp
