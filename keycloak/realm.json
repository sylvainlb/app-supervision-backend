{
  "realm": "fap-light",
  "enabled": true,
  "displayName": "FAP · Energy supervision",
  "loginTheme": "fap",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "fap-light-ui",
      "name": "Front app-supervision (Startin'blox) — statically pre-registered, decision I (no dynamic registration), front spec §13.6",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "optionalClientScopes": ["offline_access"],
      "redirectUris": ${FRONT_REDIRECT_URIS},
      "webOrigins": ${FRONT_WEB_ORIGINS},
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "webid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "webid",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "webid",
            "jsonType.label": "String"
          }
        },
                {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "name"
          }
        },
{
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "role",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "org",
            "claim.value": "${FAP_ORG}",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "manager"
      },
      {
        "name": "technician"
      },
      {
        "name": "admin"
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@${DOMAIN}",
      "firstName": "Alice",
      "lastName": "Manager",
      "attributes": {
        "webid": [
          "${BASE_IRI}users/1"
        ],
        "role": [
          "manager"
        ]
      },
      "realmRoles": [
        "manager"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@${DOMAIN}",
      "firstName": "Bob",
      "lastName": "Technician",
      "attributes": {
        "webid": [
          "${BASE_IRI}users/2"
        ],
        "role": [
          "technician"
        ]
      },
      "realmRoles": [
        "technician"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@${DOMAIN}",
      "firstName": "Fleet",
      "lastName": "Admin",
      "attributes": {
        "webid": [
          "${BASE_IRI}users/3"
        ],
        "role": [
          "admin"
        ]
      },
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "accessTokenLifespan": 3600
}