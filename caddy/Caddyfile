# REFERENCE Caddyfile (staging/prod) — the file actually mounted is .build/Caddyfile,
# RENDERED by scripts/deploy-local.sh according to ENV + API_DOMAIN/FRONT_ORIGINS in .env :
#   dev (default, API_DOMAIN=localhost) → pure HTTP :80, no certificate
#   staging                            → internal self-signed HTTPS (tls internal), local CA
#                                        .build/caddy-root.crt to import into the browser
#   prod (this file)                  → automatic Let's Encrypt HTTPS, real domain:
#                                        API_DOMAIN=fap.example.com (A record → IP)
#
# ONE site only: the BACK. The front (../app-supervision) is AUTONOMOUS (vite in its own
# directory) and calls the back in absolute, cross-origin → CORS below (FRONT_ORIGINS).
:80 {
  redir https://{host}{uri} permanent
}

https://api.example.com {
  # prod: no `tls internal` → Let's Encrypt. staging: replace with `tls internal`.

  # CORS for the autonomous front (replace with the real origins, e.g. https://app.example.com)
  @corsOrigin {
    header Origin https://app.example.com
    not path /auth/*    # /auth/*: Keycloak already answers CORS (webOrigins) — no duplicate
  }
  @preflight {
    method OPTIONS
    header Origin https://app.example.com
    not path /auth/*
  }
  handle @preflight {
    respond 204
  }
  header @corsOrigin Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @corsOrigin Access-Control-Allow-Credentials "true"
  header @corsOrigin Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  header @corsOrigin Access-Control-Allow-Headers "Authorization, DPoP, Content-Type, Accept, Origin, If-Match, If-None-Match, Slug, Link"
  header @corsOrigin Access-Control-Expose-Headers "Location, ETag, Link, Allow, WAC-Allow, Preference-Applied, Content-Location"
  header @corsOrigin Vary "Origin"

  # IdP (Keycloak) — /auth/* → issuer https://<API_DOMAIN>/auth/realms/fap-light (front spec §13.6)
  handle /auth/* {
    uri strip_prefix /auth
    reverse_proxy keycloak:8080
  }
  # DSP data plane of the FAP core (HMAC, server-to-server / external consumers)
  handle /dsp/* {
    reverse_proxy orce:1880
  }
  # Node-RED editor (admin)
  handle /editor* {
    reverse_proxy orce:1880
  }
  # Root → LDP/JSON-LD endpoint (FAP-LDP) + core flows, including POST /app/query (signed proxy,
  # the fap-ldp node excludes /app/ from the LDP middleware — patch C1.9/D-8)
  handle {
    reverse_proxy orce:1880
  }
}
