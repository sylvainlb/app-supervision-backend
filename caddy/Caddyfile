# Caddyfile de RÉFÉRENCE (staging/prod) — le fichier réellement monté est .build/Caddyfile,
# RENDU par scripts/deploy-local.sh selon ENV + API_DOMAIN/FRONT_ORIGINS dans .env :
#   dev (défaut, API_DOMAIN=localhost) → HTTP pur :80, aucun certificat
#   staging                            → HTTPS auto-signé interne (tls internal), CA locale
#                                        .build/caddy-root.crt à importer dans le navigateur
#   prod (ce fichier)                  → HTTPS Let's Encrypt automatique, vrai domaine :
#                                        API_DOMAIN=fap.example.com (A record → IP)
#
# UN SEUL site : le BACK. Le front (../app-supervision) est AUTONOME (vite dans son propre
# répertoire) et appelle le back en absolu, cross-origin → CORS ci-dessous (FRONT_ORIGINS).
:80 {
  redir https://{host}{uri} permanent
}

https://api.example.com {
  # prod : pas de `tls internal` → Let's Encrypt. staging : remplacer par `tls internal`.

  # CORS pour le front autonome (remplacer par les vraies origines, ex. https://app.example.com)
  @corsOrigin {
    header Origin https://app.example.com
    not path /auth/*    # /auth/* : Keycloak répond déjà CORS (webOrigins) — pas de doublon
  }
  @preflight {
    method OPTIONS
    header Origin https://app.example.com
    not path /auth/*
  }
  handle @preflight {
    respond 204
  }
  header @corsOrigin Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @corsOrigin Access-Control-Allow-Credentials "true"
  header @corsOrigin Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  header @corsOrigin Access-Control-Allow-Headers "Authorization, DPoP, Content-Type, Accept, Origin, If-Match, If-None-Match, Slug, Link"
  header @corsOrigin Access-Control-Expose-Headers "Location, ETag, Link, Allow, WAC-Allow, Preference-Applied, Content-Location"
  header @corsOrigin Vary "Origin"

  # IdP (Keycloak) — /auth/* → issuer https://<API_DOMAIN>/auth/realms/fap-light (spec front §13.6)
  handle /auth/* {
    uri strip_prefix /auth
    reverse_proxy keycloak:8080
  }
  # Data plane DSP du cœur FAP (HMAC, serveur-à-serveur / consommateurs externes)
  handle /dsp/* {
    reverse_proxy orce:1880
  }
  # Éditeur Node-RED (admin)
  handle /editor* {
    reverse_proxy orce:1880
  }
  # Racine → endpoint LDP/JSON-LD (FAP-LDP) + flows cœur, dont POST /app/query (proxy signé,
  # le nœud fap-ldp exclut /app/ du middleware LDP — patch C1.9/D-8)
  handle {
    reverse_proxy orce:1880
  }
}
